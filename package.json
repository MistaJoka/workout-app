{
  "name": "workout-app",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -b --force && vitest run && vite build",
    "e2e": "playwright test --project=chromium",
    "e2e:webkit": "sh scripts/e2e-webkit.sh",
    "e2e:install": "playwright install chromium",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:splash": "python3 scripts/generate-splash.py",
    "import:free-exercise-db": "tsx scripts/content/run-import-free-exercise-db.ts",
    "library:review": "tsx scripts/content/list-library-candidates.ts",
    "generate:library": "tsx scripts/content/generate-library.ts",
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "assets:generate": "python3 scripts/assets/generate-pixel-bloom-system.py",
    "assets:index": "node scripts/assets/build-asset-index.mjs",
    "assets:validate": "node scripts/assets/validate-assets.mjs",
    "assets:library": "python3 scripts/assets/generate-pixel-bloom-library.py",
    "assets:finalize": "python3 scripts/assets/finalize-pixel-bloom-platform.py",
    "rae:prompts": "python3 scripts/assets/rae-prompts.py",
    "rae:intake": "python3 scripts/assets/rae-intake.py",
    "rae:build": "python3 scripts/assets/build-rae-strips.py",
    "rae:redraw-prompts": "python3 scripts/assets/rae-redraw-prompts.py",
    "rae:preview": "python3 scripts/assets/derive-rae-preview.py",
    "rae:dump": "tsx scripts/assets/dump-exercises.ts",
    "routine:generate": "node scripts/content/generate-routine-intelligence.mjs",
    "routine:validate": "node scripts/content/validate-routine-intelligence.mjs",
    "apk": "bash scripts/build-apk.sh debug",
    "apk:release": "bash scripts/build-apk.sh release",
    "aab": "bash scripts/build-apk.sh aab",
    "generate:android-assets": "python3 scripts/generate-android-assets.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/nunito": "5.3.0",
    "dexie": "4.0.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.28.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.13",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
